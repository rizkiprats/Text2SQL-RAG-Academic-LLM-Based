# ==============================================================================
# FLASK APPLICATION CONFIGURATION (EXAMPLE)
# Copy this file to '.env' in your local environment before running the app.
# ==============================================================================

# FLASK CONFIGURATION
FLASK_APP=app_flask.py
FLASK_ENV=development                 # Options: development, staging, production
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
FLASK_DEBUG=1                         # 1 = Enable Debug Mode, 0 = Disable

# DATABASE CONFIGURATION (POSTGRESQL)
POSTGRES_DB=academic_sample_1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# LOCAL AI & LLM CONFIGURATION (Ollama/ VLLM / HuggingFace)
EMBEDDING_MODEL_SQL=sentence-transformers/multi-qa-mpnet-base-dot-v1
EMBEDDING_MODEL=intfloat/multilingual-e5-base

OLLAMA_SERVER_URL=http://localhost:11434
SQL_LLM_MODEL=llama3.2:3b-instruct-q5_0
GENERAL_LLM_MODEL=llama3.2:3b-instruct-q5_0

USE_VLLM=True
VLLM_SERVER_URL=http://localhost:8000

# SECURITY & ENCRYPTION
JWT_SECRET_KEY=your_super_secret_jwt_key_here